# 이 파일을 .env.local로 복사해서 값을 넣는다. .env.local은 커밋하지 않는다.
# 아래 값은 모두 웹앱 화면에 그대로 실리는 공개용 값이다. 비밀값(sb_secret_..., VAPID 개인키)은 절대 넣지 않는다.

# Supabase 프로젝트 주소 (https://xxxx.supabase.co)
VITE_SUPABASE_URL=
# Supabase publishable 키 (Project Settings > API Keys의 sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# 웹 푸시 공개키. 저장소 루트에서 `uv run python -m trading.notify.vapid`를 실행하면 보여 준다
VITE_VAPID_PUBLIC_KEY=

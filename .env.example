# 이 파일을 .env로 복사해서 쓴다. .env는 커밋하지 않는다.
# 로컬에서는 모의투자 키와 fake 증권사만 쓴다. 실전 키는 이 PC에 두지 않는다.

# paper(모의투자) | live(실전). live는 GitHub Actions에서만 허용된다.
TRADING_MODE=paper
# fake | kis
BROKER=fake

# 한국투자증권 (모의투자 키)
KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 앞 8자리-뒤 2자리 (예: 12345678-01)
KIS_ACCOUNT_NO=

# Supabase (대시보드 > Project Settings > API Keys의 secret 키: sb_secret_...)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# 웹 푸시. 개인키는 `uv run python -m trading.notify.vapid`가 이 파일에 직접 넣는다.
VAPID_PRIVATE_KEY=
# 푸시 서비스가 문제 있을 때 연락할 주소 (mailto:본인메일)
VAPID_SUBJECT=

# 하루 매수 금액 상한(비우면 없음). 실전 전환 초기에는 작게 둔다.
MAX_DAILY_BUY_KRW=
MAX_DAILY_BUY_USD=

# LLM 보조 기능(선택). none이면 쓰지 않는다. 설정은 docs/SETUP.md 7장.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# off | shadow(매수 후보 악재 판정을 기록만 하고 주문에는 반영하지 않음)
LLM_SCREEN=off
# 악재 판정용 공시: OpenDART API 키(국내), SEC EDGAR User-Agent(미국, 예: "stocktrade 본인메일")
DART_API_KEY=
SEC_USER_AGENT=
